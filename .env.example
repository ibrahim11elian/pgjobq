# Copy to .env for local development. Never commit .env.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The LISTEN connection must be a DIRECT connection. LISTEN state does not
# survive a transaction-mode pooler (PgBouncer transaction mode, Supabase's
# pooler port), so a pooled URL here silently degrades wakeup to polling only.
# Port 5433: docker-compose maps the container's 5432 to host 5433 to avoid
# colliding with a native PostgreSQL install on 5432.
DATABASE_URL=postgres://pgjobq:pgjobq_dev_only@localhost:5433/pgjobq

# Bounded explicitly. See docs/deployment.md for the sizing relationship
# against Postgres max_connections.
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_STATEMENT_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
# Opt-in only. Payloads are untrusted input and may carry personal data.
LOG_PAYLOADS=false

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_QUEUES=default,email,images,reports
WORKER_CONCURRENCY=10
WORKER_CLAIM_BATCH_MAX=20
WORKER_POLL_INTERVAL_MS=1000
WORKER_JOB_TIMEOUT_MS=300000
WORKER_SHUTDOWN_GRACE_MS=30000
# Fraction of the lease at which the runner extends it.
WORKER_HEARTBEAT_FRACTION=0.5

# ---------------------------------------------------------------------------
# Job defaults (overridable per queue in queue_config, then per job)
# ---------------------------------------------------------------------------
DEFAULT_MAX_ATTEMPTS=5
DEFAULT_LEASE_SECONDS=30
MAX_PAYLOAD_BYTES=262144

# Backoff: delay = min(MAX, INITIAL * MULTIPLIER^(attempt-1)), then jittered.
BACKOFF_INITIAL_MS=1000
BACKOFF_MULTIPLIER=2
BACKOFF_MAX_MS=3600000
# full | equal | none. full is the default: correlated failures otherwise
# resynchronize into a retry burst against a recovering dependency.
BACKOFF_JITTER=full
MAX_ERROR_HISTORY=5
MAX_ERROR_TEXT_BYTES=4096

# ---------------------------------------------------------------------------
# Background loops (each safe to run on every instance; all use SKIP LOCKED)
# ---------------------------------------------------------------------------
REAPER_ENABLED=true
REAPER_INTERVAL_MS=5000
REAPER_BATCH_MAX=1000

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=5000
SCHEDULER_BATCH_MAX=100

RETENTION_ENABLED=true
RETENTION_INTERVAL_MS=60000
RETENTION_BATCH_MAX=1000
RETENTION_ARCHIVE=false

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=3001
# 3001, not 3000: a Vite dev server or another local app commonly holds 3000, and on
# Windows both can bind it with the pre-existing process winning for localhost.
HOST=0.0.0.0
# Required when NODE_ENV=production: startup fails without it rather than
# exposing an unauthenticated queue.
API_BOOTSTRAP_KEY=dev-insecure-local-key-change-me
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
SSE_MAX_SUBSCRIBERS=50
CORS_ORIGIN=http://localhost:5400
