{
  "name": "@pgjobq/core",
  "version": "0.1.0",
  "description": "Durable background-job engine on PostgreSQL SKIP LOCKED. At-least-once delivery with idempotency support.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "tsc --build",
    "migrate:up": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts up",
    "migrate:status": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts status",
    "seed": "tsx --env-file-if-exists=../../.env src/cli/seed.ts"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3"
  }
}
